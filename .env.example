# LLM provider keys (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# Unify platform key (for credit tracking and logging)
UNIFY_KEY=

# Caching (default: true — cached responses replay instantly)
# Set to "false" or "write" for fresh inference
UNILLM_CACHE=true
