# Provider keys, read from the environment or a .env file. On a machine that
# holds the unify team's service-account key (~/.config/gcloud/automation.json)
# any key missing from the environment is read from Google Secret Manager
# instead, so no .env is needed there. See unillm/settings.py.

# LLM provider keys
OPENROUTER_API_KEY=
# Together AI key for OpenRouter BYOK (Together-pinned models). Register it on
# the OpenRouter workspace (Integrations UI or scripts/register_openrouter_together_byok.py).
TOGETHER_API_KEY=
# Management key only — needed to register/update BYOK via API (not for inference).
# OPENROUTER_MANAGEMENT_API_KEY=
ANTHROPIC_API_KEY=

# Caching (default: true — cached responses replay instantly)
# Set to "false" or "write" for fresh inference
UNILLM_CACHE=true
